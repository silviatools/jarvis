{
  "manifest_version": 3,
  "name": "Джарвис — WB, Ozon и Moodle на моём ПК",
  "version": "0.4.2",
  "minimum_chrome_version": "120",
  "description": "WB и Ozon, а также выполнение тестов Moodle по скриншотам выбранной вкладки. Вход остаётся в Chrome.",
  "permissions": ["storage", "alarms", "scripting", "activeTab", "debugger"],
  "host_permissions": ["https://www.wildberries.ru/*", "https://www.ozon.ru/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://www.wildberries.ru/*"],
    "js": ["field-utils.js", "page-data.js", "capture.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }, {
    "matches": ["https://www.ozon.ru/*"],
    "js": ["field-utils.js", "ozon-capture.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
