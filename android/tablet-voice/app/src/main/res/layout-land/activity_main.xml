<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101218"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/userRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="@dimen/user_pad_top"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <ru.jarvis.tablet.OrbView
                    android:id="@+id/orb"
                    android:layout_width="@dimen/orb_size"
                    android:layout_height="@dimen/orb_size"
                    android:contentDescription="@string/user_orb" />

                <TextView
                    android:id="@+id/userStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/user_off"
                    android:textColor="#F4F1EA"
                    android:textSize="@dimen/user_status"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/userCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#E6C36A"
                    android:textSize="22sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/userHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#A39E93"
                    android:textSize="15sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ScrollView
                    android:id="@+id/historyScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/historyBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp" />
                </ScrollView>

                <TextView
                    android:id="@+id/historyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/user_empty"
                    android:textColor="#6E6A62"
                    android:textSize="16sp" />
            </FrameLayout>
        </LinearLayout>

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_user_tail" />
    </LinearLayout>

    <include
        android:id="@+id/devRoot"
        layout="@layout/include_dev"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/modeToggle"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="88dp"
        android:text="@string/mode_dev"
        android:textAllCaps="false"
        android:textColor="#F4F1EA"
        android:textSize="15sp"
        app:backgroundTint="#1C1E26"
        app:strokeColor="#5C5344" />
</FrameLayout>
